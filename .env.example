# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_ADS_TARGET_CUSTOMER_ID=0987654321

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./ads_automation.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ads_automation

# Email (choose smtp or sendgrid)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=you@yourdomain.com

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Google Sheets (optional)
GSPREAD_SERVICE_ACCOUNT_JSON=./credentials/gspread_service_account.json

# App
SECRET_KEY=change_this_to_a_long_random_secret_string_at_least_32_chars
DEBUG=false
LOG_LEVEL=INFO
